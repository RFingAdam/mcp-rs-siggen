# Rohde & Schwarz Signal Generator MCP Server Configuration
# Copy this file to .env and adjust values for your setup

# =============================================================================
# Connection Settings
# =============================================================================

# Default signal generator host IP address
# Use the instrument's IP address (visible on the front panel or in network settings)
SIGGEN_DEFAULT_HOST=192.168.1.100

# Default TCP port for SCPI socket server
# R&S signal generators default to port 5025
SIGGEN_DEFAULT_PORT=5025

# TCP connection timeout in seconds
# Increase if connecting over slow/high-latency networks
SIGGEN_CONNECTION_TIMEOUT=5.0

# SCPI command timeout in seconds
# Increase for long operations like calibration or waveform loading
SIGGEN_COMMAND_TIMEOUT=30.0

# =============================================================================
# Safety Limits
# =============================================================================
# These limits protect your equipment and device under test (DUT) from damage.
# The server will reject commands that exceed these limits.

# Maximum output power in dBm
# Default +20 dBm is typical maximum for most R&S signal generators
# LOWER this value when testing:
#   - Low-noise amplifiers (LNAs): use -20 to -10 dBm
#   - Sensitive receivers: check receiver's max input power
#   - Radiated immunity: set based on amplifier/antenna system
SIGGEN_MAX_POWER_DBM=20

# Minimum output power in dBm
# Default -140 dBm is near the noise floor of most R&S signal generators
SIGGEN_MIN_POWER_DBM=-140

# Maximum frequency in Hz (67 GHz default for SMW200A)
# Set to match your signal generator's maximum frequency
# Examples:
#   - SMW200A: 67 GHz -> 67000000000
#   - SMBV100B: 6 GHz -> 6000000000
#   - SMM100A: 44 GHz -> 44000000000
#   - SGS100A: 12.75 GHz -> 12750000000
#   - SMA100B: 67 GHz -> 67000000000
#   - SMB100B: 40 GHz -> 40000000000
SIGGEN_MAX_FREQUENCY_HZ=67000000000

# Minimum frequency in Hz (8 kHz default)
# Set to match your signal generator's minimum frequency
SIGGEN_MIN_FREQUENCY_HZ=8000

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG for troubleshooting connection issues
# Use INFO for normal operation
SIGGEN_LOG_LEVEL=INFO
